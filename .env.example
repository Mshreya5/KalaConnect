# KalaConnect - Environment Variables Configuration Template
# Copy this file to '.env' and fill in your local system credentials.
# NEVER commit the actual '.env' file to Git!

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Local MySQL Community Server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=kalaconnect

# Frontend Client URL (for CORS during development)
CLIENT_URL=http://localhost:5173
